<?xml version="1.0" encoding="UTF-8"?>
<strategy name="Gold Apex Ratchet">
  <timeframe>M1</timeframe>
  <lots>0.01</lots>
  <stoploss atr="1.0" period="14"/>
  <takeprofit atr="0.7" period="14"/>
  <trail step="0.2"/>
  <!-- Buy small dips inside an uptrend: trend is up, momentum dipped, then turns back up -->
  <rule side="long" action="enter">
    <compare a="ema:9" op="gt" b="ema:21"/>
    <compare a="close" op="gt" b="ema:50"/>
    <compare a="adx:14" op="gt" b="12"/>
    <compare a="stoch:k:5:3:3" op="lt" b="55"/>
    <cross a="stoch:k:5:3:3" b="stoch:d:5:3:3" dir="above"/>
  </rule>
  <!-- Sell small bounces inside a downtrend -->
  <rule side="short" action="enter">
    <compare a="ema:9" op="lt" b="ema:21"/>
    <compare a="close" op="lt" b="ema:50"/>
    <compare a="adx:14" op="gt" b="12"/>
    <compare a="stoch:k:5:3:3" op="gt" b="45"/>
    <cross a="stoch:k:5:3:3" b="stoch:d:5:3:3" dir="below"/>
  </rule>
  <!-- Leave early if the fast trend flips -->
  <rule side="long" action="exit">
    <cross a="ema:9" b="ema:21" dir="below"/>
  </rule>
  <rule side="short" action="exit">
    <cross a="ema:9" b="ema:21" dir="above"/>
  </rule>
</strategy>
